# Copy this file to .env and adjust as needed, then load it before running
# (e.g. `export $(cat .env | xargs)` on Linux/Mac, or use a tool like
# python-dotenv / your IDE's run configuration). None of these are required
# to get started — the app has sensible defaults for everything below.

# Flask environment: "development" or "production"
FLASK_ENV=development

# Used to sign session cookies and CSRF tokens. Change this to a long random
# string before deploying anywhere real.
SECRET_KEY=dev-secret-key-change-this-in-production

# ---- Database ----
# "sqlite" (default, zero setup) or "mysql"
DB_BACKEND=sqlite

# Only used when DB_BACKEND=mysql:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=resume_analyzer

# ---- Optional enhanced semantic similarity ----
# Set to "true" AND install sentence-transformers to use embedding-based
# similarity instead of the default TF-IDF fallback.
USE_SENTENCE_TRANSFORMERS=false
